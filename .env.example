# Copy to .env and edit. Never commit .env.

# Which dataset (must exist in etl/sources.py)
SOURCE=amazon_reviews_2023
# Optional: override the categories listed in sources.py
CATEGORIES=All_Beauty,Appliances

# Where the data lake lives: "local" (folder on disk, free) or "s3"
STORAGE=local

# Only needed when STORAGE=s3
AWS_PROFILE=review-pipeline
AWS_REGION=ap-south-1
S3_BUCKET=review-analytics-yourname